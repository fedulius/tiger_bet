{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiger-bet.local/schemas/ai-brief-output.schema.json",
  "title": "AiBriefOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "brief", "risk_note", "recommended_bets"],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "brief": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000
    },
    "risk_note": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "recommended_bets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["type", "outcome", "label", "rate", "reason"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rate": { "type": "number" },
          "reason": { "type": "string", "minLength": 1 },
          "risk_label": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
