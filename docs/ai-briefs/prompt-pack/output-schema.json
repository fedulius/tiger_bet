{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiger-bet.local/schemas/ai-brief-output.schema.json",
  "title": "AiBriefOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "brief", "risk_note", "bet_explanations"],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "brief": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000
    },
    "risk_note": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "bet_explanations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["market_key", "reason"],
        "additionalProperties": false,
        "properties": {
          "market_key": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
